# Copy to web/.env.local (local) or set in Vercel > Project > Settings > Environment Variables.
# Absolute public URL of the site, used for the og:image / og:url social preview tags.
# On Vercel it can stay unset: the production domain (VERCEL_PROJECT_PRODUCTION_URL) is used automatically.
SITE_URL=https://ciel-deux-vitesses.vercel.app
